extends SceneTree

# Generic offline parse/compile gate for the mod's GDScript files.
#
# Why not --check-only: in check-only mode Godot parses the target script before
# the project's autoload singletons and global classes are registered, so every
# reference to Keys/RunData/Boss/... reports "identifier isn't declared". Running
# the check from a SceneTree script (normal startup, no window) makes the project
# fully initialise first; load() then compiles each target exactly like the mod
# loader does in-game, and can_instance() tells us whether compilation passed.
#
# Target list is generated by tests/tools/check_gd.sh into res://targets.txt
# (one res:// path per line), so new mod files are picked up automatically.
# Loaded scripts are never instantiated, so no game state is touched.

func _init():
	var failed = 0
	var total = 0
	var f = File.new()
	if f.open("res://targets.txt", File.READ) != OK:
		print("CHECK_FAIL res://targets.txt (missing target list)")
		quit(2)
		return
	while not f.eof_reached():
		var path = f.get_line().strip_edges()
		if path == "":
			continue
		total += 1
		var script = load(path)
		if script == null or not script.can_instance():
			print("CHECK_FAIL ", path)
			failed += 1
		else:
			print("CHECK_OK ", path)
	f.close()
	print("CHECK_TOTAL %d" % total)
	quit(1 if failed > 0 else 0)
