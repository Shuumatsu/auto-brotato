# -- 5c. v2.7.0 opportunity layer -------------------------------------------
# (design contract: _research/planning-v270-design.md §1 / §3 / §4.2)
#
# The acceptance contract has two independent halves:
#   CONTROL: --arb-opp=0 plus every pre-v2.7 switch =0 must be the EXACT
#     v2.6.1 behaviour -- same direction, same prepared arrays, same multi-frame
#     state -- compared against a frozen arbiter that run.sh generates from git
#     commit dcb6e39 (`git show dcb6e39:.../arbiter.gd`, no manual copy). This
#     half PASSES before v2.7 (live == v2.6.1 then) and must keep passing after
#     it lands.
#   PROBES: the new behaviour itself -- defaults, commit / no-commit decisions
#     and telemetry. This half FAILS by construction until v2.7 lands; that is
#     the test-first baseline, not a harness bug.
#
# Everything reads the new fields through get(): on a pre-v2.7 script the
# property does not exist (null) so the check fails instead of crashing.

# Every pre-v2.7 behaviour switch OFF, plus the v2.7 opportunity layer OFF and
# the v2.8 coverage/tapcd layers OFF (the exact pre-v2.7 / v2.6.1 arm; the
# frozen v2.6.1 script simply ignores the unknown cov/tapcd keys).
func control_off():
	return {"breakout": 0, "goal": 0, "pursuit": 0, "walk": 0,
			"bounty": 0, "space": 0, "roomtrack": 0, "opp": 0,
			"cov": 0, "tapcd": 0}


# Bool-tolerant telemetry read: null when the property does not exist on this
# script (pre-v2.7), otherwise the flag's boolean value (a numeric 0/1 mirror
# is accepted too).
func flag_of(a, name):
	var v = a.get(name)
	if v == null:
		return null
	if typeof(v) == TYPE_BOOL:
		return v
	if typeof(v) == TYPE_REAL or typeof(v) == TYPE_INT:
		return float(v) != 0.0
	return null


# Finite numeric telemetry read: null when missing, NaN, infinite or
# non-numeric.
func num_of(a, name):
	var v = a.get(name)
	if v == null:
		return null
	if typeof(v) != TYPE_REAL and typeof(v) != TYPE_INT:
		return null
	var f = float(v)
	if f != f:               # NaN
		return null
	if abs(f) > 1.0e18:      # +-inf
		return null
	return f


# Exact (bit-for-bit) comparison for the frozen-reference control arm: both
# sides run the same arithmetic on the same input, so a tolerance here would
# hide exactly the drift the arm exists to catch.
func val_exact(x, y):
	if typeof(x) != typeof(y):
		return false
	if typeof(x) == TYPE_VECTOR2:
		return x.x == y.x and x.y == y.y
	return x == y


func arr_exact(a, b):
	if typeof(a) != TYPE_ARRAY or typeof(b) != TYPE_ARRAY:
		return false
	if a.size() != b.size():
		return false
	for i in range(a.size()):
		if not val_exact(a[i], b[i]):
			return false
	return true


# Compares every prepared _p_* array; returns the first mismatching name
# ("" = identical). These arrays are what choose() saw after preparing the
# world, so they cover the whole threat/reward/target pricing path.
func prep_mismatch(a, b):
	var names = ["_p_pos", "_p_vel", "_p_rad", "_p_soft", "_p_coef", "_p_still",
			"_p_kill", "_p_mark", "_p_aimed", "_p_start", "_p_end", "_p_future",
			"_p_room", "_p_room_far", "_p_far"]
	for n in names:
		if not arr_exact(a.get(n), b.get(n)):
			return n
	return ""


# Compares the per-decision state the legacy layers carry between frames.
# opp=0 must leave all of it bit-identical to the frozen v2.6.1 arbiter.
func state_mismatch(a, b):
	var names = ["_bounty_on", "_bounty_pos", "_bounty_ticks", "_bounty_desired",
			"_goal_on", "_goal_pos", "_goal_value", "_goal_frac", "_goal_ticks",
			"_goal_cooldown", "_breakout_active", "_breakout_ticks",
			"_breakout_cooldown", "_adapt_ticks", "_prev_hp_ratio",
			"last_bounty", "last_bounty_dist", "last_goal", "last_goal_dist",
			"last_goal_value", "last_breakout", "last_escaping", "last_hop",
			"last_adapt", "last_kite_cost", "last_plan_used", "last_plan_evals"]
	for n in names:
		if not val_exact(a.get(n), b.get(n)):
			return n
	return ""


