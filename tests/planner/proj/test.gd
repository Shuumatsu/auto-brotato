func test_v270_control():
	print("-- v2.7.0 control arm: live(opp=0 + all old switches 0) vs frozen v2.6.1")
	var ref_script = load("res://arbiter_v261.gd")
	check(ref_script != null,
			"frozen v2.6.1 reference loads (run.sh generates it from git dcb6e39)")
	var live_script = load("res://arbiter.gd")
	check(live_script != null, "live arbiter script loads")
	if ref_script == null or live_script == null:
		return
	for s in scenarios():
		var a_live = live_script.new()
		var a_ref = ref_script.new()
		a_live.apply_overrides(control_off())
		var old_sw = control_off()
		old_sw.erase("opp")    # the frozen script has no opp switch; not needed
		a_ref.apply_overrides(old_sw)
		# Frame 0: direction + the prepared world choose() just built.
		var d0_live = call_choose(a_live, s)
		var d0_ref = call_choose(a_ref, s)
		check(d0_live == d0_ref,
				"v2.6.1 control dir identical [%s] live=%s ref=%s" %
				[s["name"], str(d0_live), str(d0_ref)])
		var pm = prep_mismatch(a_live, a_ref)
		check(pm == "",
				"v2.6.1 control prepared arrays bit-identical [%s] first_mismatch=%s" %
				[s["name"], pm])
		# Frame 1: the same inputs again -> direction and the state it carries.
		var d1_live = call_choose(a_live, s)
		var d1_ref = call_choose(a_ref, s)
		check(d1_live == d1_ref,
				"v2.6.1 control dir identical frame 2 [%s] live=%s ref=%s" %
				[s["name"], str(d1_live), str(d1_ref)])
		var sm = state_mismatch(a_live, a_ref)
		check(sm == "",
				"v2.6.1 control end state bit-identical [%s] first_mismatch=%s" %
				[s["name"], sm])


# -- 5d. v2.7.0 single-frame opportunity probes -----------------------------
# Synthetic fixtures per the design: p0 = (600,600), a class-1 special target
# (4-field tuple [pos, value, boss, class]) 800 px to the right, weapon_range
# 260 (desired range 234), speed 320, hp 100. Bodies are STATIC contact
# threats built by contact_body() in world_view's tuple layout (T_TICKS 1.6,
# T_END INF_TIME) -- a static body's route risk is 6 dmg * 1.6 = 9.6 HP, just
# under the 11 HP allowance for a value-30 special at agg=1, which is exactly
# the deliberate "accept a brush-past for a high-value target" behaviour.

func opp_scn(name, bodies, target_pos, target_value):
	var ts = []
	for b in bodies:
		ts.push_back(contact_body(b))
	var s = scn(name, Vector2(600, 600), Vector2(2400, 1400),
			ts, [], [[target_pos, target_value, false, 1.0]], [], 260.0, {})
	s["speed"] = 320.0
	s["current_hp"] = 100.0
	return s


func opp_arm(overrides, s):
	var a = new_arb()
	a.apply_overrides(overrides)
	return [a, call_choose(a, s)]


func test_v270_opp_probe():
	print("-- v2.7.0 opportunity probes (test-first: FAIL until v2.7 lands)")
	# The F1 case: one static body 250 px down the route, special at 800 px.
	var s = opp_scn("opp_special_800", [Vector2(850, 600)], Vector2(1400, 600), 30.0)
	var to_target = Vector2(1, 0)

	# (a) v2.7.0 table arm: opp=1, agg=1, cov=0 -> class-1 value 30, commit +
	# head toward the target. This probe is the frozen v2.7.0 contract ("class 1
	# = 30"), so it pins cov=0 explicitly under v2.8; the default cov=1 Boss
	# value 50 (same F1 body fixture) is checked in the v2.8 section below.
	var dflt = opp_arm({"cov": 0}, s)
	var a_def = dflt[0]
	var d_def = dflt[1]
	check(a_def.get("last_opp") != null, "opp telemetry exists: last_opp")
	check(a_def.get("last_opp_value") != null, "opp telemetry exists: last_opp_value")
	check(a_def.get("last_opp_risk") != null, "opp telemetry exists: last_opp_risk")
	check(num_of(a_def, "last_opp_value") != null, "last_opp_value is finite")
	check(num_of(a_def, "last_opp_risk") != null, "last_opp_risk is finite")
	check(flag_of(a_def, "last_opp") == true,
			"agg=1 cov=0 commits to the 800 px special (last_opp=true)")
	var v_def = num_of(a_def, "last_opp_value")
	check(v_def != null and approx(v_def, 30.0),
			"committed value == v2.7 class-1 table value 30 under cov=0 (got %s)" % str(v_def))
	var r_def = num_of(a_def, "last_opp_risk")
	check(r_def != null and r_def > 0.0 and r_def <= 200.0,
			"committed route risk finite in (0, cap 200] (got %s)" % str(r_def))
	var dot = d_def.dot(to_target)
	check(dot > 0.0,
			"agg=1 heads toward the special (dot=%.3f dir=%s)" % [dot, str(d_def)])
	print("   [probe F1] default dir=%s dot=%.3f kind=%s value=%s risk=%s" %
			[str(d_def), dot, str(a_def.get("last_opp_kind")),
			str(a_def.get("last_opp_value")), str(a_def.get("last_opp_risk"))])

	# (b) agg=0: conservative side -> no commit (the old safe-gate strict side).
	# Also cov=0 so the arm keeps testing the v2.7.0 value/risk policy exactly.
	var cons = opp_arm({"agg": 0, "cov": 0}, s)
	check(cons[0].get("last_opp") != null, "agg=0 arm exposes last_opp telemetry")
	check(flag_of(cons[0], "last_opp") == false,
			"agg=0 does NOT commit across the 250 px body (last_opp=false)")
	check(num_of(cons[0], "last_opp_value") != null
			and num_of(cons[0], "last_opp_risk") != null,
			"agg=0 telemetry values finite")
	print("   [probe F1] agg=0 dir=%s opp=%s value=%s risk=%s" %
			[str(cons[1]), str(cons[0].get("last_opp")),
			str(cons[0].get("last_opp_value")), str(cons[0].get("last_opp_risk"))])

	# (c) opp=0: the layer is entirely off -> never sets last_opp.
	var legacy = opp_arm({"opp": 0}, s)
	check(legacy[0].get("last_opp") != null, "opp=0 arm exposes last_opp telemetry")
	check(flag_of(legacy[0], "last_opp") == false,
			"opp=0 does NOT use the opportunity layer (last_opp=false)")
	check(num_of(legacy[0], "last_opp_value") != null
			and num_of(legacy[0], "last_opp_risk") != null,
			"opp=0 telemetry values finite")

	# (d) 5-body ring straddling the route: five bodies on a 50 px ring around
	# a point 250 px down the route to the 700 px special. Every body lies
	# inside the route corridor, so the estimated route damage (~44.9) exceeds
	# allowed = value*(0.10+0.20*agg)+2*agg both at the v2.7 value 30 (11) and
	# at the v2.8 default cov=1 class-1 value 50 (17). The layer must NOT commit
	# into it -- this arm runs on the v2.8 defaults (cov=1).
	var ring = []
	var ring_center = Vector2(850, 600)
	for i in range(5):
		var ang = i * TAU / 5.0
		ring.push_back(ring_center + Vector2(cos(ang), sin(ang)) * 50.0)
	var sr = opp_scn("opp_ring5_700", ring, Vector2(1300, 600), 30.0)
	var ar = opp_arm({}, sr)
	check(ar[0].get("last_opp") != null, "ring arm exposes last_opp telemetry")
	check(flag_of(ar[0], "last_opp") == false,
			"5-body ring with risk>allowed does NOT commit (last_opp=false)")
	check(num_of(ar[0], "last_opp_risk") != null, "ring last_opp_risk finite")
	print("   [probe ring5] dir=%s opp=%s value=%s risk=%s" %
			[str(ar[1]), str(ar[0].get("last_opp")),
			str(ar[0].get("last_opp_value")), str(ar[0].get("last_opp_risk"))])


# -- 5e. v2.8.0 coverage layer (--arb-cov) + real-time tap CD contract ------
# (design contract: _research/planning-v280-design.md §1 / §2 / §5.2)
#
# v2.8 replaces the single "special target" class with a coverage table:
#   Boss class1 = 50, elite class4 = 30, egg class2 = 40, cursed/evolved
#   class3 = 18; and tags rewards at tuple index 6:
#   crate tag1 = 20, legendary tag2 = 34, evo tag3 = 20, loot tag4 = 12,
#   tree tag5 = 7 -- reward value = max(raw r[1], table[tag]) via the
#   design-contract helper `_opp_reward_value(r)`. cov=0 is the EXACT v2.7.0
#   behaviour (class1 = 30, no class4, reward = raw r[1]).
#
# ASSUMPTION (design §1 table + §6 file ownership): `dps_ref_scan` and `tap_cd`
# are WORLD_VIEW-owned variables -- at v2.7 `dps_ref_scan` is declared in
# world_view.gd and the arbiter has no such variable, and v2.8 puts `tap_cd`
# there too. This project loads only the arbiter, so it asserts that the
# arbiter TOLERATES the shared --arb-* override keys (unknown keys are ignored)
# and checks the arbiter-side coverage values; the world_view-side values
# (fire_wait_frames, tap_cd, dps_ref_scan=2 weapon.current_stats path) belong to
# the Lead's world_view probe. Flag this if the design intends an arbiter mirror.

# A v2.8 probe world: p0 (600,600), speed 320, hp 100, weapon_range 260;
# `bodies` are STATIC contact bodies (world_view tuple layout), rewards/targets
# passed as-is so the tag/class encodings are exactly the ones under test.
func v28_scn(name, bodies, rewards, targets, weapon_range = 260.0):
	var ts = []
	for b in bodies:
		ts.push_back(contact_body(b))
	var s = scn(name, Vector2(600, 600), Vector2(2400, 1400),
			ts, rewards, targets, [], weapon_range, {})
	s["speed"] = 320.0
	s["current_hp"] = 100.0
	return s


# The reward tag table as 7-tuples [pos, raw, attracted, held, walk, vel|0, tag].
# Raw values are chosen so every tuple is a legal v2.7 commit too (raw >=
# GOAL_MIN_VALUE 4) except the tree, whose raw 3 is deliberately below it: the
# tree only exists as an opportunity through its tag value (max(3, 7)).
func v28_tagged_rewards():
	var rp = Vector2(900, 600)      # 300 px away: commits, small ETA cost
	return [
		["crate tag1", [rp, 6.0, true, 0.0, 0.0, 0.0, 1.0], 20.0],
		["legendary tag2", [rp, 20.0, true, 0.0, 0.0, 0.0, 2.0], 34.0],
		["evo tag3", [rp, 5.0, false, 0.0, 0.0, 0.0, 3.0], 20.0],
		["loot tag4", [rp, 8.0, true, 0.0, 0.0, Vector2(120, 0), 4.0], 12.0],
		["tree tag5", [rp, 3.0, false, 0.0, 0.0, 0.0, 5.0], 7.0]]


# Calls the design-contract helper `_opp_reward_value(r)`; null when the
# instance does not declare it (pre-v2.8) so checks fail cleanly, no crash.
func reward_value_of(a, r):
	if a.has_method("_opp_reward_value"):
		return a._opp_reward_value(r)
	return null


# The v2.7.0 opportunity commitment state (every var exists in the frozen
# e933740 arbiter; compared bit-for-bit in the v2.8 control arm).
func opp_state_mismatch(a, b):
	var names = ["_opp_on", "_opp_kind", "_opp_value", "_opp_risk", "_opp_ticks",
			"_opp_cooldown", "_opp_desired", "_opp_pull", "_opp_goal_scale",
			"_opp_src"]
	for n in names:
		if not val_exact(a.get(n), b.get(n)):
			return n
	return ""


# Scenarios that deliberately exercise the v2.8-sensitive encodings. With
# cov=0 the live v2.8 arbiter must reproduce the frozen v2.7.0 arbiter exactly
# on them (class-4 target ignored, tag value ignored, raw tree 3 below the
# commit floor), which the four ordinary scenarios cannot cover.
func v28_extra_scenarios():
	var list = []
	# class-1 special behind one static body: both v2.7 (30) and cov=0 (30)
	# commit, so the commit/pull path is compared too (cov=1 would use 50).
	list.push_back(v28_scn("v28_cov0_class1", [Vector2(850, 600)], [],
			[[Vector2(1400, 600), 30.0, false, 1.0]]))
	# class-4 (elite) target: unknown class to v2.7 => ignored, no commit.
	list.push_back(v28_scn("v28_cov0_class4", [], [],
			[[Vector2(1400, 600), 30.0, false, 4.0]]))
	# tagged rewards: v2.7/cov=0 use the raw r[1]; index 6 must be ignored.
	var rp = Vector2(900, 600)
	list.push_back(v28_scn("v28_cov0_tags", [],
			[[rp, 20.0, true, 0.0, 0.0, 0.0, 2.0],
			[Vector2(400, 900), 8.0, true, 0.0, 0.0, Vector2(120, 0), 4.0]],
			[]))
	# tree raw 3 (tag5): below GOAL_MIN_VALUE => no commit in v2.7 nor cov=0.
	list.push_back(v28_scn("v28_cov0_tree", [],
			[[Vector2(900, 600), 3.0, false, 0.0, 0.0, 0.0, 5.0]], []))
	return list


func test_v280_switches():
	print("-- v2.8.0 switches (--arb-cov; dpsref/tapcd are world_view-owned)")
	var d = new_arb()
	d.apply_overrides({})
	check(sw_is(d, "cov_enable", 1.0), "v2.8 default cov_enable == 1 (coverage layer on)")
	check(sw_is(d, "opp_enable", 1.0) and sw_is(d, "opp_agg", 1.0),
			"v2.8 keeps the v2.7 opp/agg defaults (1/1)")
	var off = new_arb()
	off.apply_overrides({"cov": 0})
	check(sw_is(off, "cov_enable", 0.0), "override cov=0 accepted")
	# dpsref/tapcd belong to world_view (design §1/§6). The arbiter receives the
	# same shared override dict from the options layer, so it must accept the
	# keys (unknown-key tolerance) without disturbing its own state.
	var tol = new_arb()
	tol.apply_overrides({"dpsref": 2, "tapcd": 0})
	check(sw_is(tol, "cov_enable", 1.0) and sw_is(tol, "opp_enable", 1.0)
			and sw_is(tol, "opp_agg", 1.0),
			"dpsref=2/tapcd=0 keys tolerated on the arbiter (world_view-owned)")
	print("   [switches] arbiter get(dps_ref_scan)=%s get(tap_cd)=%s (expected null: world_view-owned)" %
			[str(d.get("dps_ref_scan")), str(d.get("tap_cd"))])


func test_v280_control():
	print("-- v2.8.0 control arm: live(cov=0 tapcd=0) vs frozen v2.7.0 (e933740)")
	var ref_script = load("res://arbiter_v27.gd")
	check(ref_script != null,
			"frozen v2.7.0 reference loads (run.sh generates it from git e933740)")
	var live_script = load("res://arbiter.gd")
	check(live_script != null, "live arbiter script loads")
	if ref_script == null or live_script == null:
		return
	var scen = scenarios()
	for s in v28_extra_scenarios():
		scen.push_back(s)
	for s in scen:
		var a_live = live_script.new()
		var a_ref = ref_script.new()
		# cov=0 + tapcd=0 is the exact v2.7.0 arm. The frozen v2.7.0 arbiter has
		# neither key and its defaults (opp=1, agg=1, all v2.7 flags default) are
		# the reference, so it gets no overrides at all.
		a_live.apply_overrides({"cov": 0, "tapcd": 0})
		# Frame 0: direction + the prepared world choose() just built.
		var d0_live = call_choose(a_live, s)
		var d0_ref = call_choose(a_ref, s)
		check(d0_live == d0_ref,
				"v2.7.0 control dir identical [%s] live=%s ref=%s" %
				[s["name"], str(d0_live), str(d0_ref)])
		var pm = prep_mismatch(a_live, a_ref)
		check(pm == "",
				"v2.7.0 control prepared arrays bit-identical [%s] first_mismatch=%s" %
				[s["name"], pm])
		# Frame 1: the same inputs again -> direction, legacy state and the
		# opportunity commitment state (v2.7 has all of it).
		var d1_live = call_choose(a_live, s)
		var d1_ref = call_choose(a_ref, s)
		check(d1_live == d1_ref,
				"v2.7.0 control dir identical frame 2 [%s] live=%s ref=%s" %
				[s["name"], str(d1_live), str(d1_ref)])
		var sm = state_mismatch(a_live, a_ref)
		check(sm == "",
				"v2.7.0 control legacy state bit-identical [%s] first_mismatch=%s" %
				[s["name"], sm])
		var om = opp_state_mismatch(a_live, a_ref)
		check(om == "",
				"v2.7.0 control opp state bit-identical [%s] first_mismatch=%s" %
				[s["name"], om])


func test_v280_cov_probes():
	print("-- v2.8.0 coverage values (test-first: FAIL until v2.8 lands)")
	# -- special-target class table, cov=1 (the v2.8 default) --
	var class_values = [[1, 50.0], [2, 40.0], [3, 18.0], [4, 30.0]]
	for cv in class_values:
		var cls = int(cv[0])
		var want = float(cv[1])
		var a = new_arb()      # cov defaults to 1 in v2.8
		var s = v28_scn("cov1_class%d" % cls, [], [],
				[[Vector2(1400, 600), 30.0, false, float(cls)]])
		call_choose(a, s)
		check(flag_of(a, "last_opp") == true,
				"cov=1 target class %d commits (last_opp=true)" % cls)
		var v = num_of(a, "last_opp_value")
		check(v != null and approx(v, want),
				"cov=1 target class %d value == %.0f (got %s)" % [cls, want, str(v)])
	# -- the same F1 fixture as the v2.7 probe (one static body 250 px down the
	# route to an 800 px class-1 special) under the v2.8 DEFAULT cov=1: the Boss
	# is class 1 = 50, still above the 9.6 HP route risk at agg=1 (allowed 17),
	# so it commits at 50. The v2.7 probe above pins cov=0 for the 30 contract. --
	var af1 = new_arb()
	var f1 = v28_scn("v2.8_F1_body", [Vector2(850, 600)], [],
			[[Vector2(1400, 600), 30.0, false, 1.0]])
	var df1 = call_choose(af1, f1)
	check(flag_of(af1, "last_opp") == true and num_of(af1, "last_opp_value") != null
			and approx(float(num_of(af1, "last_opp_value")), 50.0),
			"v2.8 F1 default (cov=1): commits across the static body at value 50 (got %s)" %
			str(af1.get("last_opp_value")))
	check(df1.x > 0.0, "v2.8 F1 default heads toward the special (dir=%s)" % str(df1))
	# -- cov=0 keeps the v2.7 semantics: class 1 = 30, class 4 not a class --
	var a0 = new_arb()
	a0.apply_overrides({"cov": 0})
	call_choose(a0, v28_scn("cov0_class1", [], [],
			[[Vector2(1400, 600), 30.0, false, 1.0]]))
	check(flag_of(a0, "last_opp") == true and num_of(a0, "last_opp_value") != null
			and approx(float(num_of(a0, "last_opp_value")), 30.0),
			"cov=0 class 1 keeps the v2.7.0 value 30 (got %s)" %
			str(a0.get("last_opp_value")))
	var a0b = new_arb()
	a0b.apply_overrides({"cov": 0})
	call_choose(a0b, v28_scn("cov0_class4", [], [],
			[[Vector2(1400, 600), 30.0, false, 4.0]]))
	check(flag_of(a0b, "last_opp") == false,
			"cov=0 class 4 is not a v2.7 class -> no commit")

	# -- reward tag table, cov=1: last_opp_value = max(raw, table[tag]) --
	for case in v28_tagged_rewards():
		var a = new_arb()
		call_choose(a, v28_scn("cov1_reward", [], [case[1]], []))
		check(flag_of(a, "last_opp") == true and a.get("last_opp_kind") == "reward",
				"cov=1 %s commits through the reward path" % case[0])
		var v = num_of(a, "last_opp_value")
		check(v != null and approx(v, float(case[2])),
				"cov=1 %s value == %.0f (got %s)" % [case[0], float(case[2]), str(v)])

	# -- cov=0 uses the RAW r[1] (v2.7 exact) --
	var raw_cases = [6.0, 20.0, 5.0, 8.0]
	for i in range(raw_cases.size()):
		var case = v28_tagged_rewards()[i]
		var a = new_arb()
		a.apply_overrides({"cov": 0})
		call_choose(a, v28_scn("cov0_reward", [], [case[1]], []))
		check(flag_of(a, "last_opp") == true and a.get("last_opp_kind") == "reward",
				"cov=0 %s still commits through the reward path (raw >= GOAL_MIN_VALUE)" % case[0])
		var v = num_of(a, "last_opp_value")
		check(v != null and approx(v, raw_cases[i]),
				"cov=0 %s uses raw r[1] == %.0f (got %s)" %
				[case[0], raw_cases[i], str(v)])
	# Tree raw 3 < GOAL_MIN_VALUE: not an opportunity without its tag under cov=0.
	var at = new_arb()
	at.apply_overrides({"cov": 0})
	call_choose(at, v28_scn("cov0_tree", [], [v28_tagged_rewards()[4][1]], []))
	check(flag_of(at, "last_opp") == false,
			"cov=0 tree raw 3 is below GOAL_MIN_VALUE -> no commit")

	# -- design-contract helper `_opp_reward_value(r)` (planning-v280 §2) --
	var hcov = new_arb()
	check(hcov.has_method("_opp_reward_value"),
			"v2.8 helper _opp_reward_value(r) exists (design §2 contract)")
	for case in v28_tagged_rewards():
		var hv = reward_value_of(hcov, case[1])
		check(hv != null and approx(float(hv), float(case[2])),
				"cov=1 _opp_reward_value %s == %.0f (got %s)" %
				[case[0], float(case[2]), str(hv)])
	var hraw = new_arb()
	hraw.apply_overrides({"cov": 0})
	var raw_vals = [6.0, 20.0, 5.0, 8.0, 3.0]
	for i in range(raw_vals.size()):
		var case = v28_tagged_rewards()[i]
		var hv = reward_value_of(hraw, case[1])
		check(hv != null and approx(float(hv), raw_vals[i]),
				"cov=0 _opp_reward_value %s == raw %.0f (got %s)" %
				[case[0], raw_vals[i], str(hv)])

	# -- agg monotonicity must survive the new value table (compact 9-case grid:
	# classes 1/2/3 x 0/1/2 static bodies on the straight route) --
	var commits = []
	for agg in [0, 1, 2]:
		var c = 0
		for cls in [1, 2, 3]:
			for nb in [0, 1, 2]:
				var bodies = []
				for i in range(nb):
					bodies.push_back(Vector2(600.0 + 800.0 * float(i + 1)
							/ float(nb + 1), 600.0))
				var s = v28_scn("agg_grid", bodies, [],
						[[Vector2(1400, 600), 30.0, false, float(cls)]])
				var a = new_arb()
				a.apply_overrides({"agg": agg})
				call_choose(a, s)
				if flag_of(a, "last_opp") == true:
					c += 1
		commits.push_back(c)
	check(commits[0] <= commits[1] and commits[1] <= commits[2],
			"v2.8 agg monotonicity holds (commits agg0/1/2 = %s)" % str(commits))
	check(commits[0] < commits[1],
			"agg=1 strictly more willing than agg=0 (%s)" % str(commits))
	print("   [agg grid] commits=%s (9 cases per agg)" % str(commits))


# -- 6. per-decision cost --------------------------------------------------

func perf_scn(n):
	var ts = []
	for i in range(n):
		var a = i * TAU / 8.0 + i * 0.37
		var p = Vector2(950, 600) + Vector2(cos(a), sin(a)) * (340.0 + (i % 7) * 40.0)
		ts.push_back(bullet(p, Vector2(cos(a + 1.1), sin(a + 1.1)) * (160.0 + (i % 5) * 60.0)))
	return scn("perf_%d" % n, Vector2(950, 600), Vector2(1800, 1200),
			ts, [], [[Vector2(1050, 600), 5.0], [Vector2(800, 700), 4.0]], [], 300.0,
			{"kite_frac": 0.75, "hp_ratio": 1.0})


func test_perf():
	print("-- per-decision cost (avg over 100 calls, headless)")
	for n in [0, 20, 60, 90, 120]:
		var s = perf_scn(n)
		for plan in [0, 1]:
			var a = new_arb()
			a.plan_depth = plan
			call_choose(a, s)   # warm-up (state, caches)
			var t0 = OS.get_ticks_usec()
			var iters = 100
			for _i in range(iters):
				call_choose(a, s)
			var us = float(OS.get_ticks_usec() - t0) / float(iters)
			print("   threats=%d plan=%d avg_us=%.0f evals=%d used=%s" %
					[n, plan, us, a.last_plan_evals, str(a.last_plan_used)])
		if n == 120:
			var a120 = new_arb()
			call_choose(a120, s)
			check(a120.last_plan_used == false and a120.last_plan_evals == 0,
					"120 threats: planner skipped by planthreats guard")


# -- 7. planner helpers ----------------------------------------------------

func test_helpers():
	print("-- planner helpers")
	var a = new_arb()
	# _advance_threats: += vel * max(dt-start,0); start/end advance; end<=0 is
	# dropped; the optional 9th field (T_KILL, index 8) rides along.
	var ts = [
		[Vector2(100, 100), Vector2(100, 0), 5.0, 3.0, 0, 0.4, 1.0, 1.0],
		[Vector2(0, 0), Vector2.ZERO, 5.0, 3.0, 1, 0.0, 2.0, 0.5],
		[Vector2(50, 50), Vector2.ZERO, 5.0, 3.0, 1, 0.0, 2.0, 5.0, 0.7]
	]
	var adv = a._advance_threats(ts, 0.8)
	check(adv.size() == 2, "_advance_threats drops spent threats")
	check(vec_approx(adv[0][0], Vector2(140, 100)),
			"advanced pos moves for (dt-start) only")
	check(approx(adv[0][5], 0.0) and approx(adv[0][7], 0.2),
			"advanced start/end updated")
	check(adv[1].size() == 9 and approx(adv[1][8], 0.7),
			"T_KILL 9th field preserved")
	# _advance_chargers: only the cooldown clock moves.
	var cs = [[Vector2(0, 0), 200.0, 10.0, 0.3], [Vector2(0, 0), 200.0, 10.0, 2.0]]
	var ac = a._advance_chargers(cs, 0.8)
	check(approx(ac[0][3], 0.0) and approx(ac[1][3], 1.2), "charger cooldowns advance")
	# _plan_beam_indices: top-first, angularly spread by >= one sweep bin.
	var dirs = []
	var sco = []
	for k in range(24):
		var ang = k * TAU / 24.0
		dirs.push_back(Vector2(cos(ang), sin(ang)))
		sco.push_back(float(k))
	var beam = a._plan_beam_indices(dirs, sco, 4)
	check(beam.size() == 4, "beam size == K")
	check(beam[0] == 0, "beam starts at the best first-ply heading")
	var spread_ok = true
	for i in range(beam.size()):
		for j in range(i + 1, beam.size()):
			if dirs[beam[i]].dot(dirs[beam[j]]) > cos(TAU / 24.0 * 1.04):
				spread_ok = false
	check(spread_ok, "beam de-duplicated by angle (>= one sweep bin apart)")


# -- 8. pin escape + planner interaction -----------------------------------

func test_pin_planner():
	print("-- planner during pin escape")
	# Cornered on the right edge with bodies closing: the pin mode arms after
	# PIN_WINDOW stuck frames + PIN_CONFIRM. The planner must run during the
	# escape without corrupting the pin state or the prepared arrays.
	var s = scn("pin_wall", Vector2(1180, 600), Vector2(1200, 1200),
			[body(Vector2(1120, 600)), body(Vector2(1150, 640)),
			bullet(Vector2(1000, 500), Vector2(150, 50))],
			[], [[Vector2(1050, 600), 5.0]], [], 160.0, {"pin": true})
	var a0 = new_arb()
	a0.plan_depth = 0
	var a1 = new_arb()
	var escaped = false
	var planned_while_escaping = 0
	for _i in range(80):
		call_choose(a0, s)
		call_choose(a1, s)
		if a1.last_escaping:
			escaped = true
			if a1.last_plan_used:
				planned_while_escaping += 1
	check(escaped, "pin escape fires within 80 frames")
	check(a1.pin_fires == a0.pin_fires, "planner leaves pin activation count untouched")
	check(planned_while_escaping > 0, "planner also runs on escape frames (%d)" % planned_while_escaping)
	check(arr_equal(a0._p_pos, a1._p_pos) and arr_equal(a0._p_coef, a1._p_coef),
			"prepared state restored after escape frames")


