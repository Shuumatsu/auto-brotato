extends SceneTree

# Synthetic verification for the v2.3.0 arbiter changes (planner-dev, task-2),
# extended for v2.5.0 (verify-dev, task-2).
#
#   _research/tools/Godot.app/Contents/MacOS/Godot --path _research/planner-selftest/proj \
#       --no-window --script res://test.gd
#
# What this checks, beyond "it does not crash":
#   1. CONTROL ARM: with --arb-kite=0/--arb-plan=0/--arb-adapt=0 plus the four
#      v2.5 switches (--arb-breakout=0/--arb-goal=0/--arb-pursuit=0/
#      --arb-walk=0) the new script returns EXACTLY the pre-v2.3.0 script's
#      direction (arbiter_old.gd is the git-HEAD copy from that task) on every
#      synthetic scenario. The v2.5 additions default ON, so leaving them out
#      of the control arm would make this fail by construction.
#   2. PLAN RESTORE: after a planned choose(), the prepared _p_* arrays and
#      _hop_wanted/last_aoe_n are identical to an unplanned choose() with the
#      same input -- i.e. the planner's save/restore left no residue.
#   3. STANDOFF: the cost difference between w_kite=10 and w_kite=0 on the same
#      candidate equals w_kite * (1 - nd/kite_r) exactly, including the hp
#      widening; w_kite=0 pays nothing.
#   4. ADAPT: sentinel first frame, 0.15 drop fires, length = adaptsecs*60 at
#      tick_step 1 (60 at tick_step 2), expiry, adapt=0 control, and the
#      1+adaptgain threat-coefficient multiplier is actually applied.
#   5. PERF: per-decision microseconds at 0/20/60/90/120 threats, plan 0 vs 1,
#      plus the planthreats skip.
#   6. v2.5 SWITCHES: each of breakout/goal/pursuit/walk defaults to 1 and
#      accepts its =0 control override; the walk=0 arm reads a 5-tuple walk-on
#      reward exactly like the 4-tuple held reward (the 2.4.0 reading).
#   7. v2.7.0 OPPORTUNITY LAYER (--arb-opp / --arb-agg): opp/agg default to 1
#      and accept their overrides; the live arbiter with EVERY pre-v2.7 switch
#      off PLUS opp=0 is bit-identical (direction, prepared arrays, multi-frame
#      end state) to the frozen v2.6.1 arbiter generated by run.sh from git
#      commit dcb6e39; single-frame probes: a class-1 special target 800 px
#      behind one static contact body at 250 px is committed at agg=1 (default)
#      and NOT at agg=0 / opp=0; a 5-body ring whose route risk exceeds the
#      acceptance threshold is not committed either.
#   8. v2.8.0 COVERAGE LAYER (--arb-cov): cov defaults to 1; the live arbiter
#      with cov=0 (+ tapcd=0, world_view-owned) is bit-identical to the frozen
#      v2.7.0 arbiter from git e933740 on all 9 synthetic scenarios PLUS four
#      v2.8-flavoured scenarios (class-4 target, tagged rewards, loot velocity,
#      raw-3 tree); cov=1 values: target class1/2/3/4 = 50/40/18/30, reward
#      tags crate/legendary/evo/loot/tree = 20/34/20/12/7 via max(raw, table),
#      with the design-contract helper `_opp_reward_value(r)`; cov=0 uses the
#      raw r[1] (v2.7 exact); agg monotonicity still holds. `dps_ref_scan` and
#      `tap_cd` are world_view-owned, so this project only asserts the arbiter
#      tolerates their shared override keys (see the v2.8 section comment).
# Exit code = number of failures (0 = pass), so it can gate CI.

var fails = 0
var checks = 0


func check(cond, what):
	checks += 1
	if cond:
		print("ok   " + what)
	else:
		fails += 1
		print("FAIL " + what)


func approx(a, b, eps = 0.0000001):
	return abs(float(a) - float(b)) <= eps


func vec_approx(a, b, eps = 0.0000001):
	return approx(a.x, b.x, eps) and approx(a.y, b.y, eps)


# Compares two arrays of the arbiter's prepared values (Vector2 / float / bool /
# int), element by element.
func arr_equal(a, b):
	if a.size() != b.size():
		return false
	for i in range(a.size()):
		var x = a[i]
		var y = b[i]
		if typeof(x) == TYPE_VECTOR2 or typeof(y) == TYPE_VECTOR2:
			if not vec_approx(x, y):
				return false
		elif typeof(x) == TYPE_REAL or typeof(y) == TYPE_REAL:
			if not approx(x, y):
				return false
		else:
			if x != y:
				return false
	return true


func new_arb(path = "res://arbiter.gd"):
	var A = load(path)
	if A == null:
		print("LOAD_FAIL " + path)
		return null
	return A.new()


# -- synthetic scenario builders -------------------------------------------

func bullet(pos, vel, dmg = 5.0):
	return [pos, vel, 4.0, dmg, 0, 0.0, 1.0, 5.0]


func body(pos, dmg = 6.0):
	return [pos, Vector2.ZERO, 20.0, dmg, 1, 0.0, 3.0, 5.0]


# A world_view-realistic STATIC contact body (threat tuple layout:
# [pos, vel, radius, dmg, kind, T_START, T_TICKS, T_END, kill_ref?]).
# world_view prices contact threats with `_contact_ticks(unit_speed)` in the
# T_TICKS slot: CONTACT_RATE(1.6) / max(1 - enemy_speed/player_speed, 1/persist)
# -> exactly 1.6 expected damage applications per horizon for an enemy that is
# NOT closing on us (unit_speed 0), and T_END = INF_TIME. The legacy body()
# helper above carries T_TICKS=3.0/T_END=5.0 (a slower pursuer), which the v2.7
# route-risk model prices at 6*3.0 = 18 HP -- over the 11 HP risk allowance of
# a value-30 special at agg=1. F1/the v2.7 single-frame probe is about a STATIC
# body, so it must use this tuple.
func contact_body(pos, dmg = 6.0):
	return [pos, Vector2.ZERO, 20.0, dmg, 1, 0.0, 1.6, 1.0e9]


func aoe(pos, radius = 100.0, dmg = 20.0):
	return [pos, Vector2.ZERO, radius, dmg, 3, 0.0, 1.0, 2.0]


func scn(name, p0, far, threats, rewards, targets, chargers, weapon_range, profile):
	return {
		"name": name, "p0": p0, "far": far, "threats": threats,
		"rewards": rewards, "targets": targets, "chargers": chargers,
		"weapon_range": weapon_range, "profile": profile,
		"speed": 250.0, "body_radius": 18.0, "prefers_still": false,
		"current_hp": 100.0, "mitigation": 1.0
	}


func scenarios():
	var list = []

	# 1. nothing on screen: the planner is skipped (nothing to plan around).
	list.push_back(scn("empty", Vector2(600, 600), Vector2(1200, 1200),
			[], [], [], [], 160.0, {}))

	# 2. one bullet crossing: the classic greedy dodge.
	list.push_back(scn("bullet", Vector2(500, 500), Vector2(1200, 1200),
			[bullet(Vector2(900, 500), Vector2(-300, 0))], [],
			[], [], 160.0, {}))

	# 3. surrounded by bodies: no gap, pick the least bad heading.
	var ring = []
	for i in range(8):
		var a = i * TAU / 8.0
		ring.push_back(body(Vector2(500, 500) + Vector2(cos(a), sin(a)) * 160.0))
	list.push_back(scn("surround", Vector2(500, 500), Vector2(1200, 1200),
			ring, [], [], [], 160.0, {}))

	# 4. cornered: massed toward the open side, a live wall on two sides.
	var corner = []
	for i in range(5):
		corner.push_back(body(Vector2(1000 - i * 45.0, 1000 - i * 45.0)))
	corner.push_back(bullet(Vector2(900, 1100), Vector2(220, -60)))
	list.push_back(scn("corner", Vector2(1140, 1140), Vector2(1200, 1200),
			corner, [], [], [], 160.0, {}))

	# 5. ranged kit with targets + kite profile: the standoff scenario.
	list.push_back(scn("ranged_kite", Vector2(600, 600), Vector2(1600, 1200),
			[bullet(Vector2(900, 760), Vector2(-260, -120))],
			[], [[Vector2(760, 600), 5.0], [Vector2(560, 660), 4.0], [Vector2(700, 800), 3.0]],
			[], 300.0, {"kite_frac": 0.75, "hp_ratio": 1.0}))

	# 6. armed ground telegraph close by: hop candidates armed too.
	list.push_back(scn("hop_aoe", Vector2(560, 560), Vector2(1200, 1200),
			[aoe(Vector2(560, 560), 120.0, 20.0),
			bullet(Vector2(800, 560), Vector2(-220, 0))], [],
			[], [], 160.0, {}))

	# 7. idle charger about to launch + a pickup to chase.
	list.push_back(scn("charger_reward", Vector2(600, 600), Vector2(1200, 1200),
			[bullet(Vector2(900, 700), Vector2(-200, 0))],
			[[Vector2(700, 820), 4.0, true]],
			[[Vector2(820, 560), 4.0]], [[Vector2(760, 620), 220.0, 12.0, 0.1]],
			160.0, {}))

	# 8. mixed threat kinds: a 9-field killable body (T_KILL), a winding-up
	# dash whose end (0.5 s) is SHORTER than the horizon (so the second ply must
	# drop it), a ground telegraph and a spawn marker. Exercises the
	# field-preserving rebuild in _advance_threats and fire_still's _p_still.
	list.push_back(scn("mixed_kinds", Vector2(500, 500), Vector2(1200, 1200),
			[[Vector2(640, 500), Vector2.ZERO, 20.0, 6.0, 1, 0.0, 2.0, 5.0, 0.7],
			[Vector2(800, 520), Vector2(-400, 0), 16.0, 12.0, 2, 0.4, 1.0, 0.5],
			[Vector2(560, 560), Vector2.ZERO, 90.0, 20.0, 3, 0.2, 1.0, 1.5],
			[Vector2(600, 520), Vector2.ZERO, 18.0, 1.0, 4, 0.0, 1.0, 0.9]],
			[], [[Vector2(760, 500), 5.0, false]], [], 200.0,
			{"fire_still": true}))

	# 9. caution scaling composes with the planner: the weight save/restore in
	# choose() must survive the planner's nested _prepare calls.
	list.push_back(scn("caution", Vector2(600, 600), Vector2(1200, 1200),
			[bullet(Vector2(800, 600), Vector2(-260, 0)),
			body(Vector2(900, 700))], [],
			[[Vector2(700, 560), 4.0]], [], 160.0,
			{"caution": 1.5, "hp_ratio": 1.0}))

	return list


func call_choose(a, s, extra = {}):
	var profile = {}
	for k in s["profile"].keys():
		profile[k] = s["profile"][k]
	for k in extra.keys():
		profile[k] = extra[k]
	return a.choose(s["p0"], s["speed"], s["body_radius"], s["far"],
			s["threats"], s["rewards"], s["targets"], s["chargers"],
			s["weapon_range"], s["prefers_still"], s["current_hp"],
			s["mitigation"], profile)


func dir_ok(d):
	return d.length() < 0.0001 or abs(d.length() - 1.0) < 0.0001


# -- 1. control arm equals the pre-v2.3.0 script exactly -------------------

func test_control():
	print("-- control arm: new code (kite=0 plan=0 adapt=0 + v2.5 switches 0) vs git-HEAD arbiter")
	var old = load("res://arbiter_old.gd")
	check(old != null, "old arbiter script loads")
	var new_script = load("res://arbiter.gd")
	check(new_script != null, "new arbiter script loads")
	if old == null or new_script == null:
		return
	for s in scenarios():
		var a_old = old.new()
		var a_new = new_script.new()
		# The old script has none of the v2.3.0 vars; the new one gets the
		# v2.3.0 switches set directly (no apply_overrides printing for those).
		a_new.w_kite = 0.0
		a_new.plan_depth = 0
		a_new.adapt_enable = 0.0
		# v2.5.0: the four planning switches all default ON, so the exact
		# control arm has to turn them off too. Applied through the frozen
		# --arb-* override contract (rather than internal field names) so a
		# script without the switches yet simply ignores the keys.
		# v2.7.0: the opportunity layer defaults ON, so the exact pre-v2.3.0
		# control arm has to switch it off too. The key is ignored by scripts
		# that predate it, so this dict keeps working on an older arbiter.
		# v2.8.0: the coverage layer defaults ON; cov/tapcd=0 complete the arm.
		a_new.apply_overrides({"breakout": 0, "goal": 0, "pursuit": 0, "walk": 0,
			"bounty": 0, "space": 0, "roomtrack": 0, "opp": 0,
			"cov": 0, "tapcd": 0})
		var d_old = call_choose(a_old, s)
		var d_new = call_choose(a_new, s)
		check(vec_approx(d_old, d_new),
				"control dir identical [%s] old=%s new=%s" % [s["name"], str(d_old), str(d_new)])
		check(a_new.last_plan_used == false and a_new.last_plan_evals == 0,
				"control plan telemetry off [%s]" % s["name"])
		check(a_new.last_adapt == false and a_new.last_kite_cost == 0.0,
				"control kite/adapt telemetry off [%s]" % s["name"])
		check(arr_equal(a_old._p_pos, a_new._p_pos) and arr_equal(a_old._p_coef, a_new._p_coef),
				"control prepared state identical [%s]" % s["name"])


# -- 2. planner: runs, is deterministic, restores prepared state ----------

func test_planner():
	print("-- 2-ply planner")
	for s in scenarios():
		var a0 = new_arb()
		a0.plan_depth = 0
		var d0 = call_choose(a0, s)
		var a1 = new_arb()
		var d1 = call_choose(a1, s)
		check(dir_ok(d1), "plan=1 returns unit/zero dir [%s]" % s["name"])
		# A planned frame must leave the same prepared world as an unplanned
		# one: this is the save/restore contract.
		check(arr_equal(a0._p_pos, a1._p_pos), "planner restores _p_pos [%s]" % s["name"])
		check(arr_equal(a0._p_vel, a1._p_vel), "planner restores _p_vel [%s]" % s["name"])
		check(arr_equal(a0._p_rad, a1._p_rad), "planner restores _p_rad [%s]" % s["name"])
		check(arr_equal(a0._p_soft, a1._p_soft), "planner restores _p_soft [%s]" % s["name"])
		check(arr_equal(a0._p_coef, a1._p_coef), "planner restores _p_coef [%s]" % s["name"])
		check(arr_equal(a0._p_still, a1._p_still), "planner restores _p_still [%s]" % s["name"])
		check(arr_equal(a0._p_kill, a1._p_kill), "planner restores _p_kill [%s]" % s["name"])
		check(arr_equal(a0._p_mark, a1._p_mark), "planner restores _p_mark [%s]" % s["name"])
		check(arr_equal(a0._p_aimed, a1._p_aimed), "planner restores _p_aimed [%s]" % s["name"])
		check(arr_equal(a0._p_start, a1._p_start), "planner restores _p_start [%s]" % s["name"])
		check(arr_equal(a0._p_end, a1._p_end), "planner restores _p_end [%s]" % s["name"])
		check(arr_equal(a0._p_future, a1._p_future), "planner restores _p_future [%s]" % s["name"])
		check(arr_equal(a0._p_far, a1._p_far), "planner restores _p_far [%s]" % s["name"])
		check(a0._hop_wanted == a1._hop_wanted and a0.last_aoe_n == a1.last_aoe_n,
				"planner restores _hop_wanted/last_aoe_n [%s]" % s["name"])
		check(a1.last_dir == a1.last_dirs[a1.last_best_index],
				"last_dir == chosen dir [%s]" % s["name"])
		if a1.last_plan_used:
			check(plan_evals_ok(a1, a1.plan_beam * 9, s["threats"].size()),
					"planner evals match contract [%s] (%d)" % [s["name"], a1.last_plan_evals])
		else:
			check(a1.last_plan_evals == 0, "planner skipped -> 0 evals [%s]" % s["name"])
			check(vec_approx(d1, d0), "skipped planner exactly equals greedy [%s]" % s["name"])
		# Determinism: the same input must produce the same first action.
		var a2 = new_arb()
		var d2 = call_choose(a2, s)
		check(vec_approx(d1, d2), "plan=1 deterministic [%s]" % s["name"])
		# gamma=0 makes total == first-ply score, so a RUNNING planner must
		# reproduce the plain greedy winner exactly: same direction, same final
		# last_dir. This is what proves it restores state before hop/refine.
		var ag = new_arb()
		ag.plan_gamma = 0.0
		var dg = call_choose(ag, s)
		check(vec_approx(dg, d0), "gamma=0 planner mirrors greedy [%s]" % s["name"])
		check(ag.last_dir == a0.last_dir, "gamma=0 last_dir mirrors greedy [%s]" % s["name"])
		if ag.last_plan_used:
			check(plan_evals_ok(ag, ag.plan_beam * 9, s["threats"].size()),
					"gamma=0 planner actually ran [%s] (%d)" % [s["name"], ag.last_plan_evals])

	# planthreats guard: above the cap the plan must be skipped and the frame
	# must equal plain greedy.
	var big = big_threat_scn(120)
	var ag = new_arb()
	ag.plan_depth = 0
	var dg = call_choose(ag, big)
	var ap = new_arb()
	var dp = call_choose(ap, big)
	check(ap.last_plan_used == false and ap.last_plan_evals == 0,
			"threats > planthreats skips planner")
	check(vec_approx(dp, dg), "planner-skipped frame equals greedy")


func big_threat_scn(n):
	var ts = []
	for i in range(n):
		var a = i * TAU / float(n)
		var p = Vector2(950, 600) + Vector2(cos(a), sin(a)) * 420.0
		ts.push_back(bullet(p, Vector2(cos(a + 1.3), sin(a + 1.3)) * 180.0))
	return scn("big_%d" % n, Vector2(950, 600), Vector2(1800, 1200),
			ts, [], [[Vector2(1050, 600), 5.0]], [], 300.0,
			{"kite_frac": 0.75, "hp_ratio": 1.0})


# -- 3. standoff cost formula ---------------------------------------------

func test_kite():
	print("-- standoff (kite) term")
	var p0 = Vector2(600, 600)
	var far = Vector2(1600, 1200)
	var targets = [[Vector2(720, 600), 5.0]]
	var s = scn("kite_probe", p0, far, [], [], targets, [], 300.0,
			{"kite_frac": 0.75, "hp_ratio": 1.0})

	# kited (on) vs control (off): same profile, same prepared world, only the
	# kite weight differs. The cost difference must be the formula exactly.
	var a_off = new_arb()
	a_off.w_kite = 0.0
	var a_on = new_arb()
	call_choose(a_off, s)
	call_choose(a_on, s)
	# Neutralise the hysteresis term (it reads last_dir) before probing _cost.
	a_off.last_dir = Vector2.ZERO
	a_on.last_dir = Vector2.ZERO
	check(approx(a_on._kite_r, 225.0), "kite_r == kite_frac*weapon_range (225)")
	var dirs = [Vector2(1, 0), Vector2(-1, 0), Vector2(0, 1), Vector2.ZERO]
	for d in dirs:
		var c_off = a_off._cost(d, p0, 250.0, 18.0, far, [], targets, [], 300.0, false, 100.0)
		var c_on = a_on._cost(d, p0, 250.0, 18.0, far, [], targets, [], 300.0, false, 100.0)
		var pe = p0 + d * 250.0 * 0.8
		pe.x = clamp(pe.x, 18.0, far.x - 18.0)
		pe.y = clamp(pe.y, 18.0, far.y - 18.0)
		var nd = pe.distance_to(targets[0][0])
		var expected = 0.0
		if nd < 225.0:
			expected = 10.0 * (1.0 - nd / 225.0)
		check(approx(c_on - c_off, expected, 0.000001),
				"kite cost formula dir=%s expected=%.4f got=%.4f" % [str(d), expected, c_on - c_off])

	# Hurt widens the ring: hp 0.5 -> 225 * (1 + 0.4*0.5) = 270.
	var a_hurt = new_arb()
	var s_hurt = scn("kite_hurt", p0, far, [], [], targets, [], 300.0,
			{"kite_frac": 0.75, "hp_ratio": 0.5})
	call_choose(a_hurt, s_hurt)
	check(approx(a_hurt._kite_r, 270.0), "kite_r widens when hurt (270)")
	# last_kite_cost telemetry: it must be the chosen END's formula value (the
	# chosen move may legitimately end outside the ring, where it is 0).
	var a_telem = new_arb()
	var d_telem = call_choose(a_telem, s)
	var kp = p0 + d_telem * 250.0 * 0.8
	kp.x = clamp(kp.x, 18.0, far.x - 18.0)
	kp.y = clamp(kp.y, 18.0, far.y - 18.0)
	var knd = kp.distance_to(targets[0][0])
	var kexpected = 0.0
	if knd < 225.0:
		kexpected = 10.0 * (1.0 - knd / 225.0)
	check(approx(a_telem.last_kite_cost, kexpected, 0.000001),
			"last_kite_cost matches chosen end (expected=%.4f got=%.4f)" %
			[kexpected, a_telem.last_kite_cost])
	var a_ctrl = new_arb()
	a_ctrl.w_kite = 0.0
	call_choose(a_ctrl, s)
	check(a_ctrl._kite_r == 0.0 and a_ctrl.last_kite_cost == 0.0, "kite=0 is fully inert")

	# Melee / weaponless: kite_frac 0 -> no ring even with targets.
	var a_melee = new_arb()
	var s_melee = scn("kite_melee", p0, far, [], [], targets, [], 0.0,
			{"kite_frac": 0.0, "hp_ratio": 1.0})
	call_choose(a_melee, s_melee)
	check(a_melee._kite_r == 0.0 and a_melee.last_kite_cost == 0.0,
			"melee kite_frac=0 is inert")


# -- 4. hit-adaptive alert -------------------------------------------------

func test_adapt():
	print("-- hit-adaptive alert")
	var s = scn("adapt", Vector2(500, 500), Vector2(1200, 1200),
			[bullet(Vector2(900, 500), Vector2(-300, 0))],
			[], [], [], 160.0, {"hp_ratio": 1.0})
	var a = new_arb()
	call_choose(a, s, {"hp_ratio": 1.0})
	check(a.last_adapt == false, "first decision (sentinel) does not alert")
	call_choose(a, s, {"hp_ratio": 0.85})
	check(a.last_adapt == true, "0.15 single-decision drop fires the alert")
	check(a._adapt_ticks == 120, "alert length 120 decisions (2.0s @ tick_step 1)")
	# The 1+adaptgain boost must actually reach the prepared coefficients.
	var ctrl = new_arb()
	ctrl.adapt_enable = 0.0
	call_choose(ctrl, s, {"hp_ratio": 1.0})
	call_choose(ctrl, s, {"hp_ratio": 0.85})
	check(ctrl.last_adapt == false, "adapt=0 control never alerts")
	check(arr_equal(a._p_pos, ctrl._p_pos) and a._p_coef.size() == ctrl._p_coef.size(),
			"adapt does not change the prepared layout")
	var ratio = a._p_coef[0] / max(ctrl._p_coef[0], 0.000001)
	check(approx(ratio, 1.25, 0.000001), "alert boosts threat coefficients x1.25 (got %.4f)" % ratio)
	# Expiry: 120 more decisions at a stable bar, then the alert is over.
	var seen_on = 0
	for _i in range(125):
		call_choose(a, s, {"hp_ratio": 0.85})
		if a.last_adapt:
			seen_on += 1
	check(a.last_adapt == false, "alert expires after adaptsecs")
	check(seen_on >= 118 and seen_on <= 120, "alert lasted ~120 decisions (got %d)" % seen_on)
	# A small drop must NOT fire once the alert has expired.
	call_choose(a, s, {"hp_ratio": 0.80})
	check(a.last_adapt == false, "0.05 drop does not fire")
	# tick_step scaling: 2 ticks per decision -> 60 decisions for 2.0 s.
	# Regression (verifier P2): the countdown is DECISIONS, so it must burn 1
	# per choose() call, not tick_step of them -- that halved the alert at
	# tick_step 2 (2.0 s -> ~1.0 s).
	var t = new_arb()
	t.tick_step = 2
	call_choose(t, s, {"hp_ratio": 1.0})
	call_choose(t, s, {"hp_ratio": 0.8})
	check(t._adapt_ticks == 60, "adaptsecs scales with tick_step (60 @ step 2)")
	var t_on = 0
	for _i in range(65):
		call_choose(t, s, {"hp_ratio": 0.8})
		if t.last_adapt:
			t_on += 1
	check(t.last_adapt == false, "tick_step 2 alert expires")
	check(t_on >= 58 and t_on <= 60,
			"tick_step 2 alert lasts ~60 decisions = 2.0 s game time (got %d)" % t_on)
	# Floor: a fast decision cadence can never blink the alert away.
	var f = new_arb()
	f.tick_step = 16
	f.adapt_secs = 0.01
	call_choose(f, s, {"hp_ratio": 1.0})
	call_choose(f, s, {"hp_ratio": 0.8})
	check(f._adapt_ticks == 30, "ADAPT_MIN_TICKS floor (30)")


