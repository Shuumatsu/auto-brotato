# -- 5b. v2.5.0 switch contract -------------------------------------------
# Minimal, implementation-agnostic checks: the four planning switches ship ON
# by default and each accepts its exact =0 control override. Behaviour quality
# is gated by the closed-loop gate (_research/planning-v250/gate/), not here.
# `get()` returns null for a property the loaded script does not declare, so a
# pre-v2.5 script fails these checks instead of crashing.

func sw_is(a, name, want):
	var v = a.get(name)
	if v == null:
		return false
	return approx(float(v), float(want))


# v2.5.0: is the pursuit forecast switch available and ON for this instance?
func pursuit_on(a):
	var v = a.get("pursuit_enable")
	return v != null and float(v) != 0.0


# Planner evaluation accounting. The v2.3.0 second ply costs beam*9 _cost
# calls. v2.5.0 --arb-pursuit additionally advances the WHOLE threat set once
# per beam branch (the per-branch pursuit forecast) and counts that work in
# last_plan_evals, i.e. +plan_beam * threats. With --arb-pursuit=0 the tail is
# exactly the 2.4.0 count.
func plan_evals_ok(a, base, threats_n):
	if pursuit_on(a):
		return a.last_plan_evals == base + a.plan_beam * threats_n
	return a.last_plan_evals == base


