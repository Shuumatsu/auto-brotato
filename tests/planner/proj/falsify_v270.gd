extends SceneTree

# Independent falsification for the opportunity layer -- v2.7.0 round, extended
# for v2.8.0. SEPARATE from test.gd on purpose: it does not reuse test.gd's
# fixed scenarios or helpers. It fuzzes a seeded random scenario space and
# tries to BREAK the control-arm/no-regression claims rather than re-running
# the acceptance fixtures:
#
#   A. CONTROL (pre-opportunity): the frozen v2.6.1 arbiter
#      (`res://arbiter_v261.gd`, generated by run.sh from `git show
#      dcb6e39:...`) and the live arbiter with every switch OFF (old switches
#      0 + opp=0 + v2.8 cov=0/tapcd=0) must produce bit-identical behaviour on
#      arbitrary inputs: directions (exact ==), all prepared _p_* arrays, and
#      the carried per-decision state, for 3 frames per scenario.
#   A2. CONTROL v2.7.0 (v2.8 contract): live defaults + cov=0 + tapcd=0 must be
#      the EXACT frozen v2.7.0 arbiter (`res://arbiter_v27.gd` from e933740)
#      with its defaults, on the same randomized harness -- including tagged
#      reward tuples and class-4 targets, which cov=0 must ignore.
#   B. opp=0 INERT: `last_opp` must be false on every one of A's frames.
#   C. DEFAULT-PATH telemetry sanity: the four telemetry fields exist, are
#      finite and self-consistent (`last_opp` true => kind target/reward,
#      value > 0, risk in [0, cap 200]; false => value 0, risk 0). Random
#      scenarios include tagged rewards and class-4 targets so the v2.8
#      coverage table is exercised.
#   D. agg monotonicity: over a commit-count grid (distance x body-count x
#      class), agg=0 commits no more often than agg=1, and agg=1 no more often
#      than agg=2; the F1 fixture (static body 250 px on route, class-1 special
#      800 px) commits at agg=1 and not at agg=0 / opp=0.
#   E. NEGATIVE CONTROL: the comparator must detect real drift (live defaults
#      vs the frozen v2.6.1 reference diverge), otherwise A/A2 prove nothing.
#
# Run (after run.sh has written proj/arbiter.gd + proj/arbiter_v261.gd +
# proj/arbiter_v27.gd):
#   _research/tools/Godot.app/Contents/MacOS/Godot \
#       --path _research/planner-selftest/proj --no-window --script res://falsify_v270.gd
# Exit code = failures (0 = falsification found nothing).

var fails = 0
var checks = 0

# Deterministic LCG (no engine RNG dependency; same stream every run).
var _rs = 123456789


func check(cond, what):
	checks += 1
	if not cond:
		fails += 1
		print("FAIL " + what)


func fr(a, b):
	_rs = (_rs * 1103515245 + 12345) % 2147483648
	return float(a) + (float(b) - float(a)) * (float(_rs) / 2147483648.0)


func ir(a, b):   # inclusive
	return int(a) + int(floor(fr(0.0, float(int(b) - int(a) + 1))))


func approx(a, b, eps = 0.0000001):
	return abs(float(a) - float(b)) <= eps


# ---------------------------------------------------------------- comparisons

func val_exact(x, y):
	if typeof(x) != typeof(y):
		return false
	if typeof(x) == TYPE_VECTOR2:
		return x.x == y.x and x.y == y.y
	return x == y


func arr_exact(a, b):
	if typeof(a) != TYPE_ARRAY or typeof(b) != TYPE_ARRAY:
		return false
	if a.size() != b.size():
		return false
	for i in range(a.size()):
		if not val_exact(a[i], b[i]):
			return false
	return true


func prep_mismatch(a, b):
	var names = ["_p_pos", "_p_vel", "_p_rad", "_p_soft", "_p_coef", "_p_still",
			"_p_kill", "_p_mark", "_p_aimed", "_p_start", "_p_end", "_p_future",
			"_p_room", "_p_room_far", "_p_far"]
	for n in names:
		if not arr_exact(a.get(n), b.get(n)):
			return n
	return ""


func state_mismatch(a, b):
	var names = ["_bounty_on", "_bounty_pos", "_bounty_ticks", "_bounty_desired",
			"_goal_on", "_goal_pos", "_goal_value", "_goal_frac", "_goal_ticks",
			"_goal_cooldown", "_breakout_active", "_breakout_ticks",
			"_breakout_cooldown", "_adapt_ticks", "_prev_hp_ratio",
			"last_bounty", "last_bounty_dist", "last_goal", "last_goal_dist",
			"last_goal_value", "last_breakout", "last_escaping", "last_hop",
			"last_adapt", "last_kite_cost", "last_plan_used", "last_plan_evals",
			"last_dir"]
	for n in names:
		if not val_exact(a.get(n), b.get(n)):
			return n
	return ""


# -------------------------------------------------------------- telemetry read

func flag_of(a, name):
	var v = a.get(name)
	if v == null:
		return null
	if typeof(v) == TYPE_BOOL:
		return v
	if typeof(v) == TYPE_REAL or typeof(v) == TYPE_INT:
		return float(v) != 0.0
	return null


func num_of(a, name):
	var v = a.get(name)
	if v == null:
		return null
	if typeof(v) != TYPE_REAL and typeof(v) != TYPE_INT:
		return null
	var f = float(v)
	if f != f:               # NaN
		return null
	if abs(f) > 1.0e18:      # +-inf
		return null
	return f


# ------------------------------------------------------------- scenario fuzz

func contact_body(pos, dmg = 6.0):
	# world_view-realistic STATIC contact tuple: T_TICKS = 1.6, T_END = INF.
	return [pos, Vector2.ZERO, 20.0, dmg, 1, 0.0, 1.6, 1.0e9]


func clamp_in(p, far):
	var q = Vector2(p.x, p.y)
	q.x = clamp(q.x, 12.0, far.x - 12.0)
	q.y = clamp(q.y, 12.0, far.y - 12.0)
	return q


func rand_scenario(idx):
	var far = Vector2(fr(1100.0, 1900.0), fr(900.0, 1400.0))
	var p0 = Vector2(fr(80.0, far.x - 80.0), fr(80.0, far.y - 80.0))
	var threats = []
	# 0..12 random threats of all four kinds, biased near the player.
	for _i in range(ir(0, 12)):
		var kind = ir(0, 3)
		var tp = Vector2(fr(0.0, far.x), fr(0.0, far.y))
		if ir(0, 2) != 0:
			tp = clamp_in(p0 + Vector2(fr(-500.0, 500.0), fr(-500.0, 500.0)), far)
		var dmg = fr(2.0, 14.0)
		var rad = fr(10.0, 26.0)
		if kind == 0:
			var ang = fr(0.0, TAU)
			threats.push_back([tp, Vector2(cos(ang), sin(ang)) * fr(120.0, 650.0),
					fr(3.0, 6.0), dmg, 0, 0.0, 1.0, fr(0.5, 2.5)])
		elif kind == 1:
			var chase = Vector2.ZERO
			if ir(0, 1) == 0:
				chase = (p0 - tp).normalized() * fr(60.0, 220.0)
			var t = [tp, chase, rad, dmg, 1, 0.0, fr(1.0, 4.0), 1.0e9]
			if ir(0, 1) == 0:
				t.push_back(fr(0.0, 1.0))    # optional T_KILL 9th field
			threats.push_back(t)
		elif kind == 2:
			var ang2 = fr(0.0, TAU)
			threats.push_back([tp, Vector2(cos(ang2), sin(ang2)) * fr(200.0, 600.0),
					fr(12.0, 22.0), dmg, 2, fr(0.0, 0.8), 1.0, fr(1.0, 2.5)])
		else:
			threats.push_back([tp, Vector2.ZERO, fr(50.0, 150.0), dmg, 3,
					fr(0.0, 1.0), 1.0, fr(0.8, 3.0)])
	var rewards = []
	for _i in range(ir(0, 3)):
		var rp = clamp_in(p0 + Vector2(fr(-800.0, 800.0), fr(-800.0, 800.0)), far)
		if ir(0, 2) == 0:
			# v2.8 tagged reward: tag at index 6, loot velocity at index 5.
			# tag 0 has no table entry (must behave like raw). cov=0 and the
			# frozen v2.7.0 reference ignore index 6 entirely.
			var ttag = float(ir(0, 5))
			var tvel = Vector2.ZERO
			if ttag == 4.0 and ir(0, 2) == 0:
				tvel = Vector2(fr(-300.0, 300.0), fr(-300.0, 300.0))
			rewards.push_back([rp, fr(2.0, 24.0), ir(0, 1) == 0, 0.0, 0.0, tvel, ttag])
		else:
			var r = [rp, fr(2.0, 14.0)]
			var rsize = ir(2, 6)
			if rsize >= 3:
				r.push_back(ir(0, 1) == 0)
			if rsize >= 4:
				r.push_back(45.0 if ir(0, 3) == 0 else 0.0)   # held zone marker
			if rsize >= 5:
				r.push_back(1.0 if ir(0, 1) == 0 else 0.0)    # walk-on marker
			if rsize >= 6:
				r.push_back(Vector2(fr(-300.0, 300.0), fr(-300.0, 300.0)))  # loot velocity
			rewards.push_back(r)
	var targets = []
	for _i in range(ir(0, 3)):
		var tp = clamp_in(p0 + Vector2(fr(-900.0, 900.0), fr(-900.0, 900.0)), far)
		var t = [tp, fr(2.0, 40.0)]
		var tsize = ir(2, 4)
		if tsize >= 3:
			t.push_back(ir(0, 1) == 0)
		if tsize >= 4:
			t.push_back(float(ir(0, 4)))                  # special class 0..4
		targets.push_back(t)
	# Half of the scenarios get a guaranteed opportunity, so the default-path
	# telemetry section actually exercises commits instead of vetoes only.
	if ir(0, 1) == 0:
		var dist = fr(500.0, 1100.0)
		targets.push_back([clamp_in(p0 + Vector2(dist, 0.0), far), 30.0, false,
				float(ir(1, 3))])
		for _i in range(ir(0, 2)):
			var bx = p0.x + dist * fr(0.3, 0.9)
			threats.push_back(contact_body(clamp_in(Vector2(bx, p0.y), far)))
	var chargers = []
	if ir(0, 2) == 0:
		var cp = clamp_in(p0 + Vector2(fr(-400.0, 400.0), fr(-400.0, 400.0)), far)
		chargers.push_back([cp, fr(200.0, 400.0), fr(4.0, 12.0), fr(0.0, 3.0)])
	var hp0 = fr(25.0, 100.0)
	var hp1 = max(hp0 - fr(0.0, 20.0), 10.0)
	var hp2 = max(hp0 - fr(0.0, 35.0), 10.0)
	var profile = {}
	if ir(0, 1) == 0:
		profile["kite_frac"] = [0.0, 0.55, 0.75][ir(0, 2)]
	if ir(0, 2) == 0:
		profile["caution"] = fr(1.0, 1.6)
	if ir(0, 2) == 0:
		profile["engage"] = fr(0.0, 1.0)
	if ir(0, 3) == 0:
		profile["fire_still"] = true
	if ir(0, 3) == 0:
		profile["never_still"] = true
	if ir(0, 3) == 0:
		profile["orbit"] = fr(0.0, 4.0)
	if ir(0, 3) == 0:
		profile["anchor"] = Vector2(fr(0.0, far.x), fr(0.0, far.y))
		profile["anchor_radius"] = fr(100.0, 400.0)
	return {
		"name": "rnd_%d" % idx, "p0": p0, "far": far, "threats": threats,
		"rewards": rewards, "targets": targets, "chargers": chargers,
		"weapon_range": [0.0, 150.0, 260.0, 320.0, 450.0][ir(0, 4)],
		"speed": fr(180.0, 380.0), "body_radius": fr(16.0, 22.0),
		"prefers_still": ir(0, 3) == 0, "mitigation": fr(0.6, 1.0),
		"hp_frames": [hp0, hp1, hp2], "profile": profile
	}


func call_one(a, s, f):
	var prof = {}
	for k in s["profile"].keys():
		prof[k] = s["profile"][k]
	var hp = float(s["hp_frames"][f])
	prof["hp_ratio"] = hp / 100.0
	return a.choose(s["p0"], s["speed"], s["body_radius"], s["far"],
			s["threats"], s["rewards"], s["targets"], s["chargers"],
			s["weapon_range"], s["prefers_still"], hp, s["mitigation"], prof)


func old_switches_off():
	return {"breakout": 0, "goal": 0, "pursuit": 0, "walk": 0,
			"bounty": 0, "space": 0, "roomtrack": 0}


# v2.7.0 opportunity commitment state -- exists in both the frozen v2.7.0 and
# the live v2.8.0 arbiter; cov=0+tapcd=0 must leave it bit-identical.
func state_mismatch_v27(a, b):
	var names = ["_opp_on", "_opp_kind", "_opp_value", "_opp_risk", "_opp_ticks",
			"_opp_cooldown", "_opp_desired", "_opp_pull", "_opp_goal_scale",
			"_opp_src"]
	for n in names:
		if not val_exact(a.get(n), b.get(n)):
			return n
	return ""


# -- A + B: randomized control arm + opp=0 inert -----------------------------
func test_control_fuzz(n_scn):
	print("-- A/B randomized control arm: live(all switches 0) vs frozen v2.6.1")
	var live_script = load("res://arbiter.gd")
	var ref_script = load("res://arbiter_v261.gd")
	check(live_script != null, "live arbiter loads")
	check(ref_script != null, "frozen v2.6.1 arbiter loads")
	if live_script == null or ref_script == null:
		return
	var live = live_script.new()
	var ref = ref_script.new()
	var sw = old_switches_off()
	var sw_opp = old_switches_off()
	sw_opp["opp"] = 0
	# v2.8.0: cov/tapcd = 0 completes the exact pre-opportunity arm (the frozen
	# v2.6.1 script has neither key and simply ignores them).
	sw_opp["cov"] = 0
	sw_opp["tapcd"] = 0
	live.apply_overrides(sw_opp)
	ref.apply_overrides(sw)
	var frames = 3
	var dir_checks = 0
	for i in range(n_scn):
		var s = rand_scenario(i)
		for f in range(frames):
			var dl = call_one(live, s, f)
			var dr = call_one(ref, s, f)
			dir_checks += 1
			check(dl == dr, "control dir exact [%s f%d] live=%s ref=%s" %
					[s["name"], f, str(dl), str(dr)])
			var pm = prep_mismatch(live, ref)
			check(pm == "", "control prepared _p_* exact [%s f%d] first=%s" %
					[s["name"], f, pm])
			check(live.get("last_opp") == false,
					"opp=0 inert: last_opp=false [%s f%d]" % [s["name"], f])
		var sm = state_mismatch(live, ref)
		check(sm == "", "control end state exact [%s] first=%s" % [s["name"], sm])
	print("   scenarios=%d frames=%d exact-direction checks=%d" % [n_scn, frames, dir_checks])


# -- A2: randomized v2.7.0 control arm (the v2.8 exactness contract) ---------
func test_control_v27_fuzz(n_scn):
	print("-- A2 randomized v2.7.0 control arm: live defaults + cov=0 + tapcd=0 vs frozen v2.7.0")
	var live_script = load("res://arbiter.gd")
	var ref_script = load("res://arbiter_v27.gd")
	check(live_script != null, "live arbiter loads (v2.7 fuzz)")
	check(ref_script != null, "frozen v2.7.0 arbiter loads (v2.7 fuzz)")
	if live_script == null or ref_script == null:
		return
	var live = live_script.new()
	var ref = ref_script.new()
	# The reference is the frozen v2.7.0 arbiter with its own defaults (opp=1,
	# agg=1, every v2.7 flag at default) and NO overrides; the live side is the
	# v2.8 defaults with exactly the two new switches off.
	live.apply_overrides({"cov": 0, "tapcd": 0})
	var frames = 3
	var dir_checks = 0
	for i in range(n_scn):
		var s = rand_scenario(2000 + i)
		for f in range(frames):
			var dl = call_one(live, s, f)
			var dr = call_one(ref, s, f)
			dir_checks += 1
			check(dl == dr, "v2.7.0 control dir exact [%s f%d] live=%s ref=%s" %
					[s["name"], f, str(dl), str(dr)])
			var pm = prep_mismatch(live, ref)
			check(pm == "", "v2.7.0 control prepared _p_* exact [%s f%d] first=%s" %
					[s["name"], f, pm])
		var sm = state_mismatch(live, ref)
		if sm == "":
			sm = state_mismatch_v27(live, ref)
		check(sm == "", "v2.7.0 control end state exact [%s] first=%s" % [s["name"], sm])
	print("   scenarios=%d frames=%d exact-direction checks=%d" % [n_scn, frames, dir_checks])


# -- C: default-path telemetry sanity ---------------------------------------
func test_telemetry_fuzz(n_scn):
	print("-- C default-path opp telemetry sanity (opp=1 agg=1 default)")
	var live_script = load("res://arbiter.gd")
	if live_script == null:
		check(false, "live arbiter loads for telemetry fuzz")
		return
	var a = live_script.new()
	var frames = 3
	var committed = 0
	var max_risk = 0.0
	var max_value = 0.0
	var kinds = {}
	for i in range(n_scn):
		var s = rand_scenario(1000 + i)
		for f in range(frames):
			var d = call_one(a, s, f)
			var ok_dir = d.length() < 0.0001 or abs(d.length() - 1.0) < 0.0001
			check(ok_dir, "default dir unit/zero [%s f%d] d=%s" % [s["name"], f, str(d)])
			var flag = flag_of(a, "last_opp")
			var val = num_of(a, "last_opp_value")
			var risk = num_of(a, "last_opp_risk")
			check(flag != null, "last_opp exists/bool [%s f%d]" % [s["name"], f])
			check(val != null, "last_opp_value exists/finite [%s f%d]" % [s["name"], f])
			check(risk != null, "last_opp_risk exists/finite [%s f%d]" % [s["name"], f])
			if flag == true:
				committed += 1
				var kind = a.get("last_opp_kind")
				check(kind == "target" or kind == "reward",
						"committed kind is target/reward [%s f%d] kind=%s" %
						[s["name"], f, str(kind)])
				check(val != null and val > 0.0,
						"committed value > 0 [%s f%d] v=%s" % [s["name"], f, str(val)])
				check(risk != null and risk >= 0.0 and risk <= 200.0,
						"committed risk in [0, cap 200] [%s f%d] r=%s" %
						[s["name"], f, str(risk)])
				if val != null:
					max_value = max(max_value, val)
				if risk != null:
					max_risk = max(max_risk, risk)
				var k = str(kind)
				kinds[k] = int(kinds.get(k, 0)) + 1
			elif flag == false:
				check(val != null and approx(val, 0.0),
						"non-committed value is 0 [%s f%d] v=%s" % [s["name"], f, str(val)])
				check(risk != null and approx(risk, 0.0),
						"non-committed risk is 0 [%s f%d] r=%s" % [s["name"], f, str(risk)])
	print("   scenarios=%d frames=%d commits=%d max_value=%.1f max_risk=%.1f kinds=%s" %
			[n_scn, frames, committed, max_value, max_risk, str(kinds)])
	check(committed > 0, "fuzz actually exercised the layer (commits > 0)")


# -- D: agg monotonicity + F1 fixture --------------------------------------
func probe_scn(name, dist, n_bodies, special_class, target_value):
	var p0 = Vector2(600, 600)
	var far = Vector2(2400, 1400)
	var threats = []
	for i in range(n_bodies):
		var bx = 600.0 + dist * float(i + 1) / float(n_bodies + 1)
		threats.push_back(contact_body(Vector2(bx, 600.0)))
	var s = {
		"name": name, "p0": p0, "far": far, "threats": threats, "rewards": [],
		"targets": [[Vector2(600.0 + dist, 600.0), target_value, false,
				float(special_class)]],
		"chargers": [], "weapon_range": 260.0, "speed": 320.0,
		"body_radius": 18.0, "prefers_still": false, "mitigation": 1.0,
		"hp_frames": [100.0, 100.0, 100.0], "profile": {}
	}
	return s


func commit_of(overrides, s):
	var a = load("res://arbiter.gd").new()
	a.apply_overrides(overrides)
	call_one(a, s, 0)
	return flag_of(a, "last_opp") == true


func test_agg_monotonic():
	print("-- D agg commit grid (static bodies on route; class 1/2/3 values 30/40/18)")
	var dists = [600.0, 700.0, 800.0, 1000.0, 1200.0]
	var body_counts = [0, 1, 2, 3, 5]
	var classes = [1, 2, 3]
	var values = [0.0, 30.0, 40.0, 18.0]
	var commits = []
	for agg in [0, 1, 2]:
		var c = 0
		var total = 0
		for cls in classes:
			for dist in dists:
				for nb in body_counts:
					var s = probe_scn("grid", dist, nb, cls, values[cls])
					total += 1
					if commit_of({"agg": agg}, s):
						c += 1
		commits.push_back(c)
		print("   agg=%d commits=%d/%d" % [agg, c, total])
	check(commits[0] <= commits[1], "agg=0 commits <= agg=1 commits (%d vs %d)" %
			[commits[0], commits[1]])
	check(commits[1] <= commits[2], "agg=1 commits <= agg=2 commits (%d vs %d)" %
			[commits[1], commits[2]])
	check(commits[0] < commits[1], "agg=1 strictly more willing than agg=0 (%d vs %d)" %
			[commits[1], commits[0]])
	# F1 fixture exactly as specified: one static body 250 px down the route,
	# class-1 special 800 px, weapon_range 260, speed 320, hp 100.
	var f1 = {
		"name": "F1", "p0": Vector2(600, 600), "far": Vector2(2400, 1400),
		"threats": [contact_body(Vector2(850, 600))], "rewards": [],
		"targets": [[Vector2(1400, 600), 30.0, false, 1.0]],
		"chargers": [], "weapon_range": 260.0, "speed": 320.0,
		"body_radius": 18.0, "prefers_still": false, "mitigation": 1.0,
		"hp_frames": [100.0, 100.0, 100.0], "profile": {}
	}
	var a1 = load("res://arbiter.gd").new()
	var d1 = call_one(a1, f1, 0)
	check(flag_of(a1, "last_opp") == true,
			"F1: agg=1 default commits (last_opp=true)")
	check(d1.x > 0.0, "F1: agg=1 heads toward the special (dir=%s)" % str(d1))
	var risk1 = num_of(a1, "last_opp_risk")
	check(risk1 != null and risk1 > 0.0 and risk1 <= 200.0,
			"F1: agg=1 committed risk finite in (0,200] (got %s)" % str(risk1))
	var a0 = load("res://arbiter.gd").new()
	a0.apply_overrides({"agg": 0})
	call_one(a0, f1, 0)
	check(flag_of(a0, "last_opp") == false, "F1: agg=0 does NOT commit")
	var ao = load("res://arbiter.gd").new()
	ao.apply_overrides({"opp": 0})
	call_one(ao, f1, 0)
	check(flag_of(ao, "last_opp") == false, "F1: opp=0 does NOT commit")


# -- E: falsifier sensitivity (negative control) ----------------------------
# The control-arm equality above would be vacuous if the comparison could
# never fail. Compare the live DEFAULT arbiter (opp=1, agg=1) against the
# frozen v2.6.1 on a fresh fuzz stream: v2.7 is supposed to change behaviour
# exactly when an opportunity commits, so the comparator MUST see divergences.
# A zero here would mean the control-arm pass proves nothing.
func test_sensitivity(n_scn):
	print("-- E negative control: live default(opp=1) vs frozen v2.6.1 MUST diverge")
	var live_script = load("res://arbiter.gd")
	var ref_script = load("res://arbiter_v261.gd")
	check(live_script != null and ref_script != null, "scripts load for negative control")
	if live_script == null or ref_script == null:
		return
	var live = live_script.new()
	var ref = ref_script.new()
	var frames = 3
	var diverge = 0
	var committed = 0
	var total = 0
	for i in range(n_scn):
		var s = rand_scenario(5000 + i)
		for f in range(frames):
			var dl = call_one(live, s, f)
			var dr = call_one(ref, s, f)
			total += 1
			if dl != dr:
				diverge += 1
			if live.get("last_opp") == true:
				committed += 1
	print("   scenarios=%d frames=%d diverged=%d opp_committed_frames=%d" %
			[n_scn, total, diverge, committed])
	check(committed > 0, "negative control exercised opp commits (%d frames)" % committed)
	check(diverge > 0,
			"falsifier is sensitive: live(opp=1) differs from frozen v2.6.1 on %d/%d frames" %
			[diverge, total])


func _init():
	print("=== independent falsification (seeded fuzz, not test.gd fixtures) ===")
	test_control_fuzz(80)
	test_control_v27_fuzz(80)
	test_telemetry_fuzz(60)
	test_agg_monotonic()
	test_sensitivity(40)
	print("RESULT falsify checks=%d fails=%d %s" %
			[checks, fails, "PASS" if fails == 0 else "FAIL"])
	quit(0 if fails == 0 else 1)
